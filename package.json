{
  "name": "dsh-ofm-model-manager",
  "version": "2.0.0",
  "description": "Per-model enable/disable and renaming for every provider in DeepSeek Harness — disabled models disappear from the model picker, custom names replace the built-in ones. · DSH 全体模型管理：逐模型启用/停用与自定义显示名，支持按提供商分组、搜索、筛选与批量操作，改完立即生效（不用刷新页面、不用重启 DSH）。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepseekDays/dsh-ofm-model-manager.git"
  },
  "homepage": "https://github.com/DeepseekDays/dsh-ofm-model-manager#readme",
  "bugs": {
    "url": "https://github.com/DeepseekDays/dsh-ofm-model-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model",
    "manager",
    "catalog",
    "toggle",
    "rename",
    "custom-name",
    "our-free-model",
    "ofm",
    "provider",
    "all-models"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "assets",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "install.mjs",
    "src",
    "test"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node test/all.mjs",
    "test:node": "node --test --test-isolation=none test/manager.test.mjs test/host.test.mjs test/client.test.mjs test/manifest.test.mjs"
  }
}
